    ids = torch.randint(0, cfg.vocab_size, (SEQ_LEN,), generator=g).tolist()
    json.dump({"holdout_ids": ids}, open(IDS_PATH, "w"))

    end = min(CTX + N_EVAL, len(ids))
    preds = []
