            elif ARCH == "dsv4" and name.endswith(("attn_hc.base", "ffn_hc.base", "hc_base")):
                p.copy_(torch.randn_like(p) * 0.3)
            elif ARCH == "dsv4" and name.endswith(("attn_hc.scale", "ffn_hc.scale", "hc_scale")):
