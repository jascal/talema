# Copy this file to .env, then replace the API key placeholder.
# Create a key at https://platform.openai.com/api-keys
# API billing is separate from a ChatGPT subscription.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Model used for Talema dialogue (reasoning effort is low). Tested: gpt-5.4-mini, gpt-5.6-luna, gpt-6-luna.
TALEMA_MODEL=gpt-6-luna

# Optional local server settings
TALEMA_HOST=127.0.0.1
TALEMA_PORT=8765
TALEMA_TTS=kokoro

# Keep the cached books for 24 hours between requests (prompt caching); remove if your model rejects it.
TALEMA_CACHE_RETENTION=24h
